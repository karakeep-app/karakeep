# Скопировать в .env, задать уникальные секреты, chmod 600 .env.
APP_HOST=karakeep.onceup.win
KARAKEEP_IMAGE_TAG=local
KARAKEEP_SERVER_VERSION=onceup-summary
KARAKEEP_PUBLIC_ENABLED=true
DEPLOY_UID=1001
DEPLOY_GID=1001

NEXTAUTH_SECRET=replace-with-random-secret
MEILI_MASTER_KEY=replace-with-random-secret
SUMMARY_NOTEBOOKLM_TOKEN=replace-with-random-secret
SUMMARY_HERMES_API_KEY=replace-with-dedicated-random-secret

OAUTH_WELLKNOWN_URL=https://pocket-id.onceup.win/.well-known/openid-configuration
OAUTH_CLIENT_ID=replace-with-pocket-id-client-id
OAUTH_CLIENT_SECRET=replace-with-pocket-id-client-secret
DISABLE_SIGNUPS=true
DISABLE_PASSWORD_AUTH=true

SUMMARY_READER_ENABLED=true
SUMMARY_AUTO_TAGS_ENABLED=true
SUMMARY_HERMES_URL=http://host.docker.internal:8642/p/karakeep-summary/v1
