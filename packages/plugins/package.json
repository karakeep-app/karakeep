{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@karakeep/plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./assetstore-filesystem": "./assetstore-filesystem/index.ts",
    "./assetstore-filesystem/implementation": "./assetstore-filesystem/src/index.ts",
    "./assetstore-s3": "./assetstore-s3/index.ts",
    "./assetstore-s3/implementation": "./assetstore-s3/src/index.ts",
    "./queue-liteque": "./queue-liteque/index.ts",
    "./queue-restate": "./queue-restate/index.ts",
    "./ratelimit-memory": "./ratelimit-memory/index.ts",
    "./ratelimit-redis": "./ratelimit-redis/index.ts",
    "./search-meilisearch": "./search-meilisearch/index.ts",
    "./vectorstore-meilisearch": "./vectorstore-meilisearch/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --ignore-path=../../.gitignore --check .",
    "format:fix": "oxfmt --ignore-path=../../.gitignore .",
    "lint": "oxlint --ignore-path=../../.gitignore .",
    "lint:fix": "oxlint --ignore-path=../../.gitignore . --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@karakeep/shared": "workspace:*",
    "@restatedev/restate-sdk": "^1.16.2",
    "@restatedev/restate-sdk-clients": "^1.16.2",
    "async-mutex": "^0.4.1",
    "glob": "^11.0.0",
    "liteque": "^0.9.1",
    "meilisearch": "^0.58.0",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "@karakeep/tsconfig": "workspace:^0.1.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
