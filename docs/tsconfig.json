{
  // @docusaurus/tsconfig 3.x, inlined without "baseUrl" (removed in
  // TypeScript 7; "paths" resolve relative to this file without it).
  // Docusaurus 4 drops it from the preset, so docs can extend it again then.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "../node_modules/docusaurus-plugin-openapi-docs/src/types.d.ts"
  ]
}
