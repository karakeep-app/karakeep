     return "ExpoShareIntent"
   }
 
-  // members to store the initial launch intent
-  var intent: Intent? = null
+  private const val PREFS_NAME = "expo-share-intent"
+  private const val PREFS_CONSUMED_LAUNCH_INTENT = "consumedLaunchIntent"
+
+  // share intent waiting for JS to ask for it (getShareIntent)
+  private var intent: Intent? = null
+  // id of the task this intent launched, null when it came through onNewIntent
+  private var launchTaskId: Int? = null
   var isPending: Boolean = false
+
+  @Synchronized
+  fun setPendingIntent(intent: Intent, launchTaskId: Int?) {
+    this.intent = intent
+    this.launchTaskId = launchTaskId
+    isPending = true
+  }
+
+  @Synchronized
+  fun clearPendingIntent() {
+    intent = null
+    launchTaskId = null
+  }
+
+  /**
+   * Returns the pending intent (if any) and clears it. If the intent is the one that launched the
+   * task, remember it so that Android re-delivering it later is not treated as a new share.
+   */
+  @Synchronized
+  fun takePendingIntent(context: Context?): Intent? {
+    val pending = intent ?: return null
+    val taskId = launchTaskId
+    clearPendingIntent()
+    if (taskId != null && context != null) {
+      context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+        .edit()
+        .putString(PREFS_CONSUMED_LAUNCH_INTENT, consumedKey(taskId, pending))
+        .apply()
+    }
+    return pending
+  }
+
+  /**
+   * Android keeps the intent that started a task and hands it to the activity again whenever the
+   * activity is recreated in that task (e.g. after the process was killed in the background and the
+   * user comes back from the launcher or recents). Such a share was already handled.
+   */
+  fun isReplayedLaunchIntent(context: Context, taskId: Int, intent: Intent): Boolean {
+    if (intent.flags and Intent.FLAG_ACTIVITY_LAUNCHED_FROM_HISTORY != 0) {
+      return true
+    }
+    val consumed = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+      .getString(PREFS_CONSUMED_LAUNCH_INTENT, null)
+    return consumed == consumedKey(taskId, intent)
+  }
+
+  private fun consumedKey(taskId: Int, intent: Intent): String {
+    @Suppress("DEPRECATION")
+    val stream = intent.extras?.get(Intent.EXTRA_STREAM)
+    val fingerprint = listOf(
+      intent.action,
+      intent.type,
+      intent.dataString,
+      intent.getStringExtra(Intent.EXTRA_TEXT),
+      stream?.toString(),
+    ).joinToString("\u0000")
+    return "$taskId:${fingerprint.hashCode()}"
+  }
 }
