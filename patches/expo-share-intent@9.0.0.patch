index 0000000000000000000000000000000000000000..8258d653884938fe14eb99e3c16bb512aa109a12
--- /dev/null
+++ b/android/src/main/java/expo/modules/shareintent/ExpoShareIntentTrampolineActivity.kt
@@ -0,0 +1,39 @@
+package expo.modules.shareintent
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Bundle
+import android.util.Log
+
+/**
+ * Receives the share intents (the config plugin puts the intent filters here instead of on the
+ * main activity) and forwards them to the main activity in the app's own task.
+ *
+ * Android launches the share target in the sharing app's task when the share sheet was started for
+ * a result (e.g. by apps using Flutter's share_plus), even if the target is singleTask. If that
+ * target were the main activity, a second react surface would mount in that task and get torn down
+ * (taking the main activity's surface with it) as soon as the share is moved to the app's task.
+ * This activity has no UI, so it doesn't matter which task it starts in.
+ */
+class ExpoShareIntentTrampolineActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val target = packageManager.getLaunchIntentForPackage(packageName)?.component
+        if (target != null) {
+            val grantFlags = Intent.FLAG_GRANT_READ_URI_PERMISSION or
+                Intent.FLAG_GRANT_WRITE_URI_PERMISSION or
+                Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION or
+                Intent.FLAG_GRANT_PREFIX_URI_PERMISSION
+            val forward = Intent(intent).apply {
+                component = target
+                // Drop the original launch flags (FORWARD_RESULT, NEW_DOCUMENT, MULTIPLE_TASK, ...),
+                // keeping only the uri grants so the main activity can read the shared files.
+                flags = (intent.flags and grantFlags) or Intent.FLAG_ACTIVITY_NEW_TASK
+            }
+            startActivity(forward)
+        } else {
+            Log.w("ExpoShareIntent", "No launch activity to forward the share to, dropping it")
+        }
+        finish()
+    }
+}
