---
import { ClientRouter } from "astro:transitions";
import "@karakeep/tailwind-config/globals.css";

import { BASE_URL } from "../constants";

interface Props {
  title?: string;
  description?: string;
}

const DEFAULT_TITLE =
  "Karakeep - The Bookmark Everything App | Save, Organize & Tag with AI";
const DEFAULT_DESCRIPTION =
  "Karakeep is the open-source bookmark manager for links, notes, and images. Automatically organize and tag your bookmarks with AI. Self-hostable, with apps for iOS, Android, Chrome, and Firefox.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} | Karakeep` : DEFAULT_TITLE;
const canonicalPath = `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const url = `${BASE_URL}${canonicalPath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#171717" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Karakeep" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://karakeep.com/opengraph-image.png"
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Karakeep bookmark manager app screenshot"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://karakeep.com/twitter-image.png"
    />
    <meta
      name="twitter:image:alt"
      content="Karakeep bookmark manager app screenshot"
    />

    <!--
      No media attributes here: Google's favicon crawler skips icons that are
      conditional on a media query. favicon.svg adapts to dark mode itself.
    -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&display=swap"
    />

    <style is:global>
      :root {
        /* Headline font (font-display utility): applied to h1/h2/h3 and the
           big stat numbers only. Body copy stays on the system stack. */
        --font-display: "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
      }
    </style>

    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
